# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=lufi.example.com

# Address shown in the footer and used for expired upload notices
LUFI_CONTACT=admin@example.com

# Secret used to sign upload links, keep it to encrypt existing files
APP_SECRET_KEY=replace-with-a-random-secret-min-32-chars

# Largest accepted upload in bytes, 100 MiB by default
LUFI_MAX_FILE_SIZE=104857600

# Expiry delay in days applied when the sender does not pick one, 0 disables
LUFI_DEFAULT_DELAY=0

# Largest delay a sender may choose, 0 disables the limit
LUFI_MAX_DELAY=0
